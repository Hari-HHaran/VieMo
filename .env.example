# TMDB "API Read Access Token" (Settings → API on themoviedb.org). Server-side only; never prefix with NEXT_PUBLIC_.
TMDB_READ_TOKEN=
# Optional: the older v3 "API Key" works too if you don't have the read token.
# TMDB_API_KEY=
# Default viewing region for availability and cinema listings (ISO 3166-1). People can change it in Profile.
TMDB_DEFAULT_REGION=SG
# Reel Director (/director). OpenAI secret key, server-side only; never prefix with NEXT_PUBLIC_. Without it the page says it's off.
OPENAI_API_KEY=
# Optional: the OpenAI model Reel Director uses (default gpt-5-mini).
# OPENAI_MODEL=
