# TMDB "API Read Access Token" (Settings → API on themoviedb.org). Server-side only; never prefix with NEXT_PUBLIC_.
TMDB_READ_TOKEN=
# Optional: the older v3 "API Key" works too if you don't have the read token.
# TMDB_API_KEY=
# Default viewing region for availability and cinema listings (ISO 3166-1). People can change it in Profile.
TMDB_DEFAULT_REGION=SG
# Reel Director (/director). An OpenAI secret key, or a key from an OpenAI-compatible provider. Server-side only; never prefix with NEXT_PUBLIC_. Without it the page says it's off.
OPENAI_API_KEY=
# Only for keys that aren't from OpenAI: your provider's API address, e.g. https://api.example.com/v1
# OPENAI_BASE_URL=
# Optional: the model Reel Director uses (default gpt-5-mini). With another provider, use one of its model IDs.
# OPENAI_MODEL=
# Optional: limits for Mo, the chat companion (it uses the same OPENAI_API_KEY).
# MO_MESSAGES_PER_MINUTE=10
# MO_DAILY_MESSAGES_PER_VISITOR=150
# MO_DAILY_TOKENS=2000000

# Accounts (Supabase → Project Settings → API). The URL and publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret. Server only: never prefix with NEXT_PUBLIC_. Needed for the demo import, signed-out WheelMo spins and Mo's daily cap.
SUPABASE_SERVICE_ROLE_KEY=
# Your site's address, used in sign-up and password-reset email links, e.g. https://viemo.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: the demo community (see docs/supabase-setup.md, section 6).
# DEMO_SEED_ENABLED=false
# DEMO_COMMUNITY=hide
# Optional: make Movie Night rooms check every few seconds instead of using Supabase Realtime.
# NIGHT_REALTIME=off
